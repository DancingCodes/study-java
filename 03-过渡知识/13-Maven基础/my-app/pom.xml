<?xml version="1.0" encoding="UTF-8"?>
<!-- 上面这行是 XML 声明：告诉解析器这是 XML 文件，版本 1.0，字符编码是 UTF-8 -->

<!-- 下面这三行是 Maven 的命名空间和 schema 声明，让 IDE 知道 pom.xml 的格式规范，能做语法检查 -->
<!-- 固定写法，不用记，当模板用就行 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本，固定写 4.0.0 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- GAV 坐标：三个字段组合起来唯一标识一个项目 -->
    <groupId>com.example</groupId>        <!-- 组织/公司，通常是倒着写的域名 -->
    <artifactId>my-app</artifactId>       <!-- 项目名 -->
    <version>1.0.0</version>              <!-- 版本号 -->

    <!-- 依赖列表：你的项目需要用到的外部库都写在这里 -->
    <dependencies>
        <!-- 每个 dependency 就是一个外部库，用 GAV 坐标定位 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>  <!-- Gson 库的组织名 -->
            <artifactId>gson</artifactId>             <!-- Gson 库的项目名 -->
            <version>2.10.1</version>                 <!-- Gson 库的版本号 -->
        </dependency>
    </dependencies>

    <!-- 插件配置 -->
    <build>
        <plugins>
            <!-- exec-maven-plugin：让你用 mvn exec:java 直接运行程序 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!-- 指定主类，这样运行时不用每次手动输入类名 -->
                    <mainClass>MavenDemo</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
