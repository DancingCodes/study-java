# 练习 1：容器化 Spring Boot 应用
#
# 步骤：
#   1. 先在 app 目录下执行 mvn clean package -DskipTests 打包
#   2. docker build -t docker-demo:1.0 .
#   3. docker run -d --name docker-demo -p 8080:8080 docker-demo:1.0
#   4. 访问 http://localhost:8080 验证

